{
  "family": "prep-intel-dev",
  "executionRoleArn": "arn:aws:iam::533267153582:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::533267153582:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "prep-intel-dev",
      "image": "533267153582.dkr.ecr.us-east-1.amazonaws.com/prep-intel-app:latest",
      "essential": true,
      "memory": 512, 
      "cpu": 256,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
            "awslogs-group": "prep-intel",
            "awslogs-region": "us-east-1",
            "awslogs-stream-prefix": "prep-intel-dev"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
