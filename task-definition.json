{
    "family": "intel-prep-app-task",
    "executionRoleArn": "arn:aws:ecs:us-east-1:533267153582:cluster/intel-prep-ecs-cluster",
    "taskRoleArn": "arn:aws:iam::533267153582:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
      {
        "name": "my-app",
        "image": "533267153582.dkr.ecr.us-east-1.amazonaws.com/prep-intel-app",
        "essential": true,
        "memoryReservation": 512,
        "cpu": 256,
        "portMappings": [
          {
            "containerPort": 80,
            "hostPort": 80
          }
        ]
      }
    ],
    "requiresCompatibilities": ["EC2"],
    "cpu": "512",
    "memory": "1024"
  }
  